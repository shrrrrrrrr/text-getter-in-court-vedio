# Copy to .env locally; run.ps1 imports this file. Never commit real values.
COURT_ASR_MODEL=large-v3
COURT_DEVICE=cpu
COURT_COMPUTE_TYPE=int8
# Explicit opt-in to model downloads. Set 0 once weights are cached.
COURT_ALLOW_MODEL_DOWNLOAD=0
HF_TOKEN=
COURT_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Local experimental two-source separator, disabled unless selected per task.
COURT_SEPARATION_MODEL=speechbrain/sepformer-whamr16k
# Optional paid cloud backend; only called when explicitly selected in the UI.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-shanghai
COURT_TENCENT_ENGINE=16k_zh_en_meeting
# Optional local OpenAI-compatible text/vision model. Only loopback URLs allowed.
COURT_ROLE_API_BASE=
COURT_ROLE_API_KEY=
COURT_ROLE_MODEL=
# Optional campus mode; leave empty for the original single-user loopback workspace.
COURT_ACCESS_DB=
COURT_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Explicit HTTP test mode only. Campus IP HTTP does not encrypt network traffic.
COURT_ALLOW_CAMPUS_HTTP=0
COURT_WORKER_SUBPROCESS=0
COURT_GPU_UUID=
